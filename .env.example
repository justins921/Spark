# Postgres connection string. Vercel's Neon integration sets this for you when
# you add a database from the Storage tab — it may be named DATABASE_URL,
# STORAGE_URL or POSTGRES_URL depending on how the store was created, and the
# app takes whichever one it finds. Pull it locally with:
#   vercel env pull .env.local
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# The single password that unlocks the whole app.
APP_PASSWORD="change-me"

# The timezone "today" is judged in. Vercel runs in UTC, so without this a
# delivery logged at 9pm Central lands on tomorrow's date. Defaults to
# America/Chicago; set it if you move.
APP_TIMEZONE="America/Chicago"
